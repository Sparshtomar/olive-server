# Postgres connection string (local: Homebrew on 5432, or `npm run db:up` on 5433; prod: Neon)
DATABASE_URL=postgres://olive:olive@localhost:5432/olive

# "gemini" for real analysis, "mock" to run without an API key (deterministic fake results)
AI_PROVIDER=gemini
# From aistudio.google.com (starts with AIza) or Vertex AI Express Mode (starts with AQ.)
GEMINI_API_KEY=
# Tried in order; the next model is used when one is rate-limited or unavailable.
GEMINI_MODELS=gemini-3-flash-preview,gemini-2.5-flash,gemini-2.5-flash-lite

PORT=4010
# Optional. Set when running more than one instance so rate limits are shared (see docs/adr/0006).
# REDIS_URL=redis://localhost:6379
# Comma-separated list of allowed web origins, or * for any
CORS_ORIGIN=*
LOG_LEVEL=info
